# Feed aggregator (Miniflux), which Newsboat on the workstations reads through its
# native Miniflux backend (`urls-source "miniflux"`, see home/rss.nix).
#
# Reachable over cloud-admin only, as https://feeds.<domain>. The vhost is bound to the
# caddy container's ULA and there is no public route.
#
# The public DNS record exists only for ACME HTTP-01. The challenge arrives on port 80 and
# the plain-HTTP vhost below answers it (see the assertion in hosts/lux/caddy.nix).
#
# The subscription list is owned by Nix. mine.services.miniflux.feeds is set in
# external/private, because feed URLs are user-identifying data. A oneshot inside the
# container reconciles the instance against that list. A feed that is no longer listed is
# deleted, and its entries go with it.
{ lib
, self
, config
, pkgs
, noxa
, specialArgs
, luxAddr6For
, luxPublicNetwork6
, ...
}:
with lib;
{
  options.mine.services.miniflux.feeds = mkOption {
    type = types.listOf (types.submodule {
      options = {
        url = mkOption {
          type = types.str;
          description = ''
            Feed URL. The reconcile compares URLs with trailing slashes stripped, so this
            is also the key that decides whether a feed stays or is deleted.
          '';
          example = "https://nixos.org/blog/stories-rss.xml";
        };
        category = mkOption {
          type = types.nullOr types.str;
          default = null;
          description = ''
            Miniflux category for this feed, created on demand. When null, the feed keeps
            whichever category it has. Miniflux categories are imported by Newsboat as
            tags.
          '';
          example = "NixOS";
        };
      };
    });
    default = [ ];
    description = ''
      The authoritative subscription list. A feed that is in Miniflux but not in this list
      is deleted, together with its entries, by the reconcile unit.
    '';
  };

  config =
    let
      cfg = config.mine.services.miniflux;

      domain = self.lib.requireOption "mine.info.domain" config.mine.info.domain;
      feedsDomain = "feeds.${domain}";

      hostAddress6 = luxAddr6For "fc00::/64" "miniflux-veth-host";
      port = 8080;

      adminCredentialsIdentifier = noxa.lib.secrets.computeIdentifier {
        module = "miniflux";
        ident = "admin-credentials";
        hosts = [ "lux" ];
      };
      adminCredentialsSecret = config.age.secrets.${adminCredentialsIdentifier};

      # API keys of the admin user, one per workstation (Newsboat, home/rss.nix): shared
      # secrets <workstation>+lux, generated by users/mx.nix's miniflux-api-token generator
      apiTokenHosts = filter
        (host: self.nixosConfigurations.${host}.config.mine.presets.isWorkstation)
        (attrNames self.nixosConfigurations);
      apiTokenIdentifier = host: noxa.lib.secrets.computeIdentifier {
        module = "miniflux";
        ident = "api-token";
        hosts = [ host "lux" ];
      };
      apiTokenPath = host: "/run/secrets/miniflux-api-token-${host}";
      # Writes each token into api_keys as `nix:<host>` (Miniflux stores keys as plain 64
      # hex characters), and drops `nix:` keys of hosts that are gone. Keys created in the UI
      # are not touched. The tokens reach psql on stdin, never on a command line.
      apiKeysScript = pkgs.writeShellScript "miniflux-api-keys" ''
        set -euo pipefail
        {
          echo "BEGIN;"
          ${concatMapStrings (host: ''
            token="$(< ${apiTokenPath host})"
            [[ "$token" =~ ^[0-9a-f]{64}$ ]] || { echo "${apiTokenPath host}: not 64 hex characters" >&2; exit 1; }
            # the admin user of services.miniflux (ADMIN_USERNAME of the admin-credentials generator)
            echo "INSERT INTO api_keys (user_id, token, description) SELECT id, '$token', 'nix:${host}' FROM users WHERE username = 'admin' ON CONFLICT (user_id, description) DO UPDATE SET token = EXCLUDED.token;"
          '') apiTokenHosts}
          echo "DELETE FROM api_keys WHERE description LIKE 'nix:%' AND description NOT IN (${concatMapStringsSep ", " (host: "'nix:${host}'") apiTokenHosts});"
          echo "COMMIT;"
        } | ${pkgs.util-linux}/bin/runuser -u postgres -- ${config.containers.miniflux.config.services.postgresql.package}/bin/psql -v ON_ERROR_STOP=1 -d miniflux
      '';

      # Rendered at evaluation time, so a malformed list fails the build, not the unit.
      desiredStateFile = (pkgs.formats.json { }).generate "miniflux-feeds" cfg.feeds;

      reconcile = pkgs.writeShellApplication {
        name = "miniflux-reconcile";
        runtimeInputs = [
          pkgs.curl
          pkgs.jq
        ];
        text = builtins.readFile ./miniflux-reconcile.sh;
      };
    in
    {
      assertions = [
        {
          assertion = length cfg.feeds == length (unique (map (feed: feed.url) cfg.feeds));
          message = "mine.services.miniflux.feeds: duplicate feed URL, the reconcile keys on it.";
        }
      ];

      noxa.secrets.def = [
        {
          ident = "admin-credentials";
          module = "miniflux";
          hosts = [ "lux" ];
          generator.script = "miniflux-admin-credentials";
          owner = "root";
          mode = "0400";
        }
      ] ++ map
        (host: {
          ident = "api-token";
          module = "miniflux";
          hosts = [ host "lux" ];
          generator.script = "miniflux-api-token"; # users/mx.nix
          owner = "root";
          mode = "0400";
        })
        apiTokenHosts;
      # plain file names: the agenix path of shared secrets has colons and a comma, which the
      # container's --load-credential=ID:PATH would split (see hosts/lux/vaultwarden.nix)
      age.secrets = listToAttrs (map
        (host: nameValuePair (apiTokenIdentifier host) { name = "miniflux-api-token-${host}"; })
        apiTokenHosts);

      # `ADMIN_USERNAME`/`ADMIN_PASSWORD` in EnvironmentFile form: services.miniflux creates
      # the admin user from them (`CREATE_ADMIN`), and the reconcile unit authenticates with
      # the same pair.
      age.generators.miniflux-admin-credentials = { pkgs, ... }: ''
        printf 'ADMIN_USERNAME=admin\nADMIN_PASSWORD=%s\n' "$(${pkgs.openssl}/bin/openssl rand -hex 32)"
      '';

      mine.services.caddyProxy.routes.feeds = {
        upstream = "[${config.containers.miniflux.localAddress6}]:${toString port}";
        # no `public`: the route lives on cloud-admin only
        wireguardNetworks.cloud-admin.hostname = feedsDomain;
      };

      # The public A/AAAA record needs a port-80 answer for the ACME challenge. All other
      # requests are redirected. HTTPS cannot follow that redirect, because 443 is not
      # bound publicly for this name.
      containers.caddy.config = {
        services.caddy.virtualHosts.${"http://${feedsDomain}"} = {
          logFormat = null;
          extraConfig = ''
            redir https://{host}{uri} 308
          '';
        };
      };

      systemd.tmpfiles.rules = [
        "d /persist/data/miniflux 0700 root root -"
        "d /persist/data/miniflux/postgres - - - -" # nspawn refuses a missing bind mount source; owner left to the container's postgres
      ];

      containers.miniflux = {
        autoStart = true;
        privateNetwork = true;
        inherit hostAddress6;
        localAddress6 = luxAddr6For luxPublicNetwork6 "miniflux";
        ephemeral = true;
        inherit specialArgs;

        bindMounts = {
          postgres = {
            hostPath = "/persist/data/miniflux/postgres";
            mountPoint = "/var/lib/postgresql";
            isReadOnly = false;
          };
          # under the secrets dir: handed over as a systemd credential and installed by
          # nixos/container_isolation.nix, not bind mounted
          credentials = {
            hostPath = adminCredentialsSecret.path;
            mountPoint = "/run/secrets/miniflux-admin-credentials";
            isReadOnly = true;
          };
        } // listToAttrs (map
          (host: nameValuePair "api-token-${host}" {
            hostPath = config.age.secrets.${apiTokenIdentifier host}.path;
            mountPoint = apiTokenPath host;
            isReadOnly = true;
          })
          apiTokenHosts) // {
          # not under /run: the container's systemd mounts a tmpfs there
          feeds = {
            hostPath = toString desiredStateFile;
            mountPoint = "/etc/miniflux-feeds.json";
            isReadOnly = true;
          };
        };

        config = { ... }: {
          imports = [
            (import ./container-common.nix { inherit (config.system) stateVersion; inherit (config.time) timeZone; inherit hostAddress6; })
          ];

          networking.firewall.allowedTCPPorts = [ port ];

          services.miniflux = {
            enable = true;
            adminCredentialsFile = "/run/secrets/miniflux-admin-credentials";
            config = {
              # caddy reaches it over the container's ULA
              LISTEN_ADDR = "[::]:${toString port}";
              BASE_URL = "https://${feedsDomain}/";
              RUN_MIGRATIONS = true;
              # how often the server polls feeds, independent of whether a client reads
              POLLING_FREQUENCY = 60;
              # read entries are archived after two months, unread ones are never archived
              ARCHIVE_READ_DAYS = 60;
            };
          };

          # The workstations' API keys follow the agenix secrets (see apiKeysScript). Runs at
          # every container start, so a rekeyed token applies with the container's restart.
          systemd.services.miniflux-api-keys = {
            description = "Register the workstations' Miniflux API keys";
            wantedBy = [ "multi-user.target" ];
            requires = [ "miniflux.service" ];
            # miniflux created the schema and the admin user; the tokens are installed
            after = [ "miniflux.service" "container-credentials.service" ];
            restartTriggers = [ apiKeysScript ];
            serviceConfig = {
              Type = "oneshot";
              ExecStart = apiKeysScript;
            };
          };

          # Subscriptions follow Nix. Started by the timer below, not by activation: adding
          # feeds fetches each one (slow or unreachable ones take seconds), and a switch would
          # wait for the whole run and kill it on restart.
          systemd.services.miniflux-reconcile = {
            description = "Reconcile Miniflux subscriptions with the Nix feed list";
            wants = [ "network-online.target" ];
            requires = [ "miniflux.service" ];
            after = [
              "miniflux.service"
              "network-online.target"
            ];
            serviceConfig = {
              Type = "oneshot";
              ExecStart = getExe reconcile;
              TimeoutStartSec = "30min"; # bounds a hanging run (each API call has its own 60s limit)
            };
          };
          systemd.timers.miniflux-reconcile = {
            wantedBy = [ "timers.target" ];
            # a changed feed list restarts the timer on switch, which runs the reconcile soon after
            restartTriggers = [ desiredStateFile ];
            timerConfig = {
              OnActiveSec = "30s"; # after boot or the switch
              OnUnitActiveSec = "1d"; # retries feeds that failed
            };
          };
        };
      };
    };
}
