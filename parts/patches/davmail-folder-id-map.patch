+    /**
+     * Look up folderPath in davmail.folderIds, a ';' separated list of
+     * path=EWS folder id entries, e.g.
+     * /users/shared@company.com/calendar/Team=AAMkAD...
+     * Reaches folders shared with the user one by one (as OWA does) without
+     * access to their parent folders, which the path lookup below needs.
+     *
+     * @param folderPath folder path
+     * @return mapped folder id or null
+     */
+    protected FolderId getMappedFolderId(String folderPath) {
+        String folderIds = Settings.getProperty("davmail.folderIds");
+        if (folderIds == null || folderIds.isEmpty()) {
+            return null;
+        }
+        String path = stripTrailingSlashes(folderPath);
+        for (String entry : folderIds.split(";")) {
+            int equalsIndex = entry.indexOf('=');
+            if (equalsIndex <= 0) {
+                continue;
+            }
+            String mappedPath = stripTrailingSlashes(entry.substring(0, equalsIndex).trim());
+            if (!mappedPath.equalsIgnoreCase(path)) {
+                continue;
+            }
+            String id = entry.substring(equalsIndex + 1).trim();
+            // the owning mailbox, for getCalendarEmail
